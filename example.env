# Copy this file to .env and fill in the values. .env is git-ignored.

# The Apache Superset that test/e2e/run.sh uses. The values below fit the Superset in Docker
# from `make superset.up` (test/superset/compose.yaml). For your own Superset, change them.
SUPERSET_HOST=http://localhost:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin

# For uptest (make e2e, make uptest): the credentials JSON object for the same Superset, in
# the format that a ProviderConfig Secret holds. Keep the single quotes. uptest runs the
# provider inside the kind cluster, where localhost is the provider itself, so the Superset
# in Docker is http://superset:8088 here.
UPTEST_CLOUD_CREDENTIALS='{"host": "http://superset:8088", "username": "admin", "password": "admin"}'
